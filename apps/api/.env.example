NODE_ENV=development
PORT=3000

# Local dev: docker compose in infra/docker (see infra/docker/docker-compose.dev.yml)
# Staging/prod: swap for your Neon connection string
DATABASE_URL=postgresql://anontalk:anontalk@localhost:5433/anontalk?schema=public

# Local dev: docker compose in infra/docker
# Staging/prod: swap for your Upstash Redis URL (rediss://...)
REDIS_URL=redis://localhost:6380

WEB_APP_URL=http://localhost:3001
